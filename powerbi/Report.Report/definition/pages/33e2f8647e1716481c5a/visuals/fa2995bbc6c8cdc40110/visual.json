            "jsonSpec": {
              "expr": {
                "Literal": {
                  "Value": "'{\n  \"$schema\": \"https://vega.github.io/schema/vega-lite/v5.json\",\n\n  \"data\": {\n    \"name\": \"dataset\"\n  },\n\n  \"transform\": [\n    {\n      \"fold\": [\n        \"Average of recency\",\n        \"Average of frequency\",\n        \"Average of monetary\"\n      ],\n      \"as\": [\"raw_metric\", \"value\"]\n    },\n\n    {\n      \"calculate\": \"datum.raw_metric == ''Average of recency'' ? ''R'' : datum.raw_metric == ''Average of frequency'' ? ''F'' : ''M''\",\n      \"as\": \"Metric\"\n    },\n\n    {\n      \"joinaggregate\": [\n        {\n          \"op\": \"min\",\n          \"field\": \"value\",\n          \"as\": \"min_val\"\n        },\n        {\n          \"op\": \"max\",\n          \"field\": \"value\",\n          \"as\": \"max_val\"\n        }\n      ],\n      \"groupby\": [\"Metric\"]\n    },\n\n    {\n      \"calculate\": \"datum.max_val == datum.min_val ? 0.5 : (datum.Metric == ''R'' ? (datum.max_val - datum.value) / (datum.max_val - datum.min_val) : (datum.value - datum.min_val) / (datum.max_val - datum.min_val))\",\n      \"as\": \"norm_score\"\n    }\n  ],\n\n  \"mark\": {\n    \"type\": \"rect\",\n    \"stroke\": \"#d0e1f2\",\n    \"strokeWidth\": 1.5\n  },\n\n  \"encoding\": {\n\n    \"y\": {\n      \"field\": \"segment\",\n      \"type\": \"nominal\",\n      \"title\": null,\n\n      \"sort\": [\n        \"Champions\",\n        \"Loyal Customers\",\n        \"Potential Loyalists\",\n        \"Recent Customers\",\n        \"Promising Customers\"\n      ],\n\n      \"scale\": {\n        \"paddingInner\": 0.15,\n        \"paddingOuter\": 0.05\n      },\n\n      \"axis\": {\n        \"orient\": \"left\",\n        \"labelFontSize\": 13,\n        \"labelFontWeight\": \"500\",\n        \"labelColor\": \"#1a2b3c\",\n        \"labelPadding\": 12,\n        \"labelAlign\": \"right\",\n        \"labelBaseline\": \"middle\",\n        \"domain\": false,\n        \"ticks\": false\n      }\n    },\n\n    \"x\": {\n      \"field\": \"Metric\",\n      \"type\": \"nominal\",\n      \"title\": null,\n\n      \"sort\": [\n        \"R\",\n        \"F\",\n        \"M\"\n      ],\n\n      \"axis\": {\n        \"orient\": \"top\",\n        \"labelAngle\": 0,\n        \"labelFontSize\": 13,\n        \"labelFontWeight\": \"bold\",\n        \"labelColor\": \"#1a2b3c\",\n        \"labelPadding\": 10,\n        \"domain\": false,\n        \"ticks\": false\n      }\n    },\n\n    \"color\": {\n      \"field\": \"norm_score\",\n      \"type\": \"quantitative\",\n\n      \"scale\": {\n        \"domain\": [0, 1],\n        \"range\": [\n          \"#f7fbff\",\n          \"#6baed6\",\n          \"#08306b\"\n        ]\n      },\n\n      \"legend\": null\n    },\n\n    \"tooltip\": [\n      {\n        \"field\": \"segment\",\n        \"type\": \"nominal\",\n        \"title\": \"Segment\"\n      },\n      {\n        \"field\": \"Metric\",\n        \"type\": \"nominal\",\n        \"title\": \"Metric\"\n      },\n      {\n        \"field\": \"value\",\n        \"type\": \"quantitative\",\n        \"title\": \"Average Value\",\n        \"format\": \",.2f\"\n      }\n    ]\n  },\n\n  \"config\": {\n    \"view\": {\n      \"stroke\": \"#d0e1f2\",\n      \"strokeWidth\": 1,\n      \"cornerRadius\": 6\n    },\n\n    \"background\": \"transparent\"\n  }\n}'"
                }
