            "jsonSpec": {
              "expr": {
                "Literal": {
                  "Value": "'{\n  \"$schema\": \"https://vega.github.io/schema/vega-lite/v5.json\",\n  \"data\": {\n    \"name\": \"dataset\"\n  },\n  \"width\": \"container\",\n  \"height\": 380,\n  \"transform\": [\n    {\n      \"calculate\": \"length(data(''dataset'')) > 0 ? data(''dataset'')[0][''Model''] : ''Customer Segmentation''\",\n      \"as\": \"Selected Model\"\n    }\n  ],\n  \"title\": {\n    \"text\": {\n      \"expr\": \"length(data(''dataset'')) > 0 ? data(''dataset'')[0][''Model''] + '' Cluster Visualization'' : ''Customer Cluster Visualization''\"\n    },\n    \"subtitle\": {\n      \"expr\": \"length(data(''dataset'')) > 0 ? ''X = '' + data(''dataset'')[0][''X Label''] + ''     |     Y = '' + data(''dataset'')[0][''Y Label''] : ''''\"\n    },\n    \"anchor\": \"start\",\n    \"fontSize\": 16,\n    \"subtitleFontSize\": 12,\n    \"subtitleColor\": \"#666666\"\n  },\n  \"mark\": {\n    \"type\": \"circle\",\n    \"filled\": true,\n    \"opacity\": 0.65,\n    \"size\": 48\n  },\n  \"encoding\": {\n    \"x\": {\n      \"field\": \"X Value\",\n      \"type\": \"quantitative\",\n      \"title\": {\n        \"expr\": \"length(data(''dataset'')) > 0 ? data(''dataset'')[0][''X Label''] : ''X Value''\"\n      },\n      \"axis\": {\n        \"grid\": true,\n        \"labelFontSize\": 10,\n        \"titleFontSize\": 12\n      }\n    },\n    \"y\": {\n      \"field\": \"Y Value\",\n      \"type\": \"quantitative\",\n      \"title\": {\n        \"expr\": \"length(data(''dataset'')) > 0 ? data(''dataset'')[0][''Y Label''] : ''Y Value''\"\n      },\n      \"axis\": {\n        \"grid\": true,\n        \"labelFontSize\": 10,\n        \"titleFontSize\": 12\n      }\n    },\n    \"color\": {\n      \"field\": \"Cluster\",\n      \"type\": \"nominal\",\n      \"title\": \"Cluster\",\n      \"scale\": {\n        \"domain\": [0, 1, 2],\n        \"range\": [\n          \"#2878B5\",\n          \"#E58B32\",\n          \"#3A9D75\"\n        ]\n      },\n      \"legend\": {\n        \"orient\": \"bottom\",\n        \"title\": \"Cluster\",\n        \"labelFontSize\": 10\n      }\n    },\n    \"tooltip\": [\n      {\n        \"field\": \"Customer ID\",\n        \"type\": \"nominal\",\n        \"title\": \"Customer ID\"\n      },\n      {\n        \"field\": \"Model\",\n        \"type\": \"nominal\",\n        \"title\": \"Model\"\n      },\n      {\n        \"field\": \"Cluster\",\n        \"type\": \"nominal\",\n        \"title\": \"Cluster\"\n      },\n      {\n        \"field\": \"X Label\",\n        \"type\": \"nominal\",\n        \"title\": \"X Feature\"\n      },\n      {\n        \"field\": \"X Value\",\n        \"type\": \"quantitative\",\n        \"title\": \"X Value\",\n        \"format\": \",.2f\"\n      },\n      {\n        \"field\": \"Y Label\",\n        \"type\": \"nominal\",\n        \"title\": \"Y Feature\"\n      },\n      {\n        \"field\": \"Y Value\",\n        \"type\": \"quantitative\",\n        \"title\": \"Y Value\",\n        \"format\": \",.2f\"\n      }\n    ]\n  },\n  \"config\": {\n    \"background\": \"transparent\",\n    \"view\": {\n      \"stroke\": null\n    },\n    \"axis\": {\n      \"labelColor\": \"#666666\",\n      \"titleColor\": \"#333333\",\n      \"domainColor\": \"#CCCCCC\",\n      \"tickColor\": \"#CCCCCC\"\n    },\n    \"title\": {\n      \"color\": \"#222222\"\n    }\n  }\n}'"
