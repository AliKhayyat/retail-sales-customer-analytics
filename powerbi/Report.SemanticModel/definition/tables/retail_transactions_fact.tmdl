table retail_transactions_fact
	lineageTag: 6c542225-ee73-418f-a9c6-012f61d9cf02

	measure 'Avg Recency' =
			
			AVERAGEX(
			    VALUES('retail customer_master'[customer_id]),
			    VAR LastPurchase =
			        CALCULATE(
			            MAX('retail_transactions_fact'[Invoice Date Only]),
			            'retail_transactions_fact'[Quantity] > 0,
			            'retail_transactions_fact'[Price] > 0
			        )
			    RETURN
			        IF(
			            NOT ISBLANK(LastPurchase),
			            DATEDIFF(
			                LastPurchase,
			                MAX('DimDate'[Date]),
			                DAY
			            )
			        )
			)
		lineageTag: 817d0981-5488-45d0-b331-1c52b0f72cb6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Frequencyy' =
			
			AVERAGEX(
			    VALUES('retail customer_master'[customer_id]),
			    CALCULATE(
			        DISTINCTCOUNT('retail_transactions_fact'[Invoice]),
			        'retail_transactions_fact'[Quantity] > 0,
			        'retail_transactions_fact'[Price] > 0
			    )
			)
		lineageTag: cb49e171-c237-4e64-848f-fc75b2112071

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Monetary' =
			
			AVERAGEX(
			    VALUES('retail customer_master'[customer_id]),
			    CALCULATE(
			        SUM('retail_transactions_fact'[LineValue]),
			        'retail_transactions_fact'[Quantity] > 0,
			        'retail_transactions_fact'[Price] > 0
			    )
			)
		lineageTag: c0097d90-fabb-4c63-874a-b5a3692ea211

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'RFM Customerss' =
			
			DISTINCTCOUNT('retail customer_master'[customer_id])
		formatString: 0
		lineageTag: ebe58bb6-4043-4d19-953c-797acac4754d

	measure 'Monthly Customer Activity %' =
			
			VAR MonthlyCustomers =
			    CALCULATE(
			        DISTINCTCOUNT(
			            'retail_transactions_fact'[Customer ID]
			        ),
			        'retail_transactions_fact'[Customer ID] <> BLANK(),
			        'retail_transactions_fact'[Quantity] > 0,
			        'retail_transactions_fact'[Price] > 0
			    )
			
			VAR PeriodCustomers =
			    CALCULATE(
			        DISTINCTCOUNT(
			            'retail_transactions_fact'[Customer ID]
			        ),
			        ALLSELECTED('DimDate'),
			        'retail_transactions_fact'[Customer ID] <> BLANK(),
			        'retail_transactions_fact'[Quantity] > 0,
			        'retail_transactions_fact'[Price] > 0
			    )
			
			RETURN
			    DIVIDE(
			        MonthlyCustomers,
			        PeriodCustomers
			    )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: d0bf7ae3-ff71-48e2-a609-d45f7b2e92cb

	measure Measure
		lineageTag: 6cce1c9f-3f9e-4247-87a4-3f3db8d1bd49

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	measure 'Purchase Timing Insight' =
			
			VAR SelectedStart =
			    MIN('DimDate'[Date])
			VAR SelectedEnd =
			    MAX('DimDate'[Date])
			VAR ActiveCustomers =
			    CALCULATE(
			        DISTINCTCOUNT('retail_transactions_fact'[Customer ID]),
			        'retail_transactions_fact'[Customer ID] <> BLANK(),
			        'retail_transactions_fact'[Quantity] > 0,
			        'retail_transactions_fact'[Price] > 0
			    )
			VAR AvgRecency =
			    [Avg Recency]
			VAR TopSegment =
			    TOPN(
			        1,
			        ADDCOLUMNS(
			            ALL('retail customer_master'[segment]),
			            "@Recency",
			            [Avg Recency]
			        ),
			        [@Recency], ASC
			    )
			VAR TopSegmentName =
			    MAXX(
			        TopSegment,
			        'retail customer_master'[segment]
			    )
			RETURN
			    "Between "
			        & FORMAT(SelectedStart, "MMM yyyy")
			        & " and "
			        & FORMAT(SelectedEnd, "MMM yyyy")
			        & ", "
			        & FORMAT(ActiveCustomers, "#,##0")
			        & " customers were active. "
			        & TopSegmentName
			        & " had the lowest average recency at "
			        & FORMAT(AvgRecency, "0")
			        & " days."
		lineageTag: 1f14a013-7501-465f-9bff-0cb69a76a3d2

