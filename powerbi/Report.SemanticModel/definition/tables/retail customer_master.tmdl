	column 'Overdue Status Display' =
			
			IF(
			    ISBLANK('retail customer_master'[overdue_status]),
			    "Insufficient History",
			    'retail customer_master'[overdue_status]
			)
		lineageTag: 469935a6-022d-4afa-ad54-09f72c378ebf
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Purchase Behavior Category' =
			
			SWITCH(
			    'retail customer_master'[purchase_behavior_cluster],
			    0, "Premium Niche Buyers",
			    1, "High-Volume Buyers",
			    2, "Regular Buyers",
			    "Insufficient History"
			)
		lineageTag: 5c327018-42fb-4525-909f-d737d1437384
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'retail customer_master' = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("localhost", "retail_analytics"),
				    retail_customer_master = Source{[Schema="retail",Item="customer_master"]}[Data]
				in
				    retail_customer_master

	annotation PBI_ResultType = Table

