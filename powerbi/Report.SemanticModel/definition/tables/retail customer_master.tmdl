table 'retail customer_master'
	lineageTag: 5f3edc17-87cc-4519-8d8d-db58d59b2675

	measure 'Total Customers' =
			
			CALCULATE(
			    DISTINCTCOUNT('retail_transactions_fact'[Customer ID]),
			    'retail_transactions_fact'[Quantity] > 0,
			    'retail_transactions_fact'[Price] > 0
			)
		formatString: 0
		lineageTag: 338088bd-01f4-4464-90bb-7a1ecdb7ae91

	measure 'Total Monetary' =
			
			CALCULATE(
			    SUM('retail_transactions_fact'[LineValue]),
			    'retail_transactions_fact'[Customer ID] <> BLANK()
			)
		lineageTag: 039a0ee7-1057-48d3-8f48-ad116e845be3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Frequency' =
			
			AVERAGEX(
			    FILTER(
			        VALUES('retail_transactions_fact'[Customer ID]),
			        NOT ISBLANK('retail_transactions_fact'[Customer ID])
			    ),
			    CALCULATE(
			        DISTINCTCOUNT('retail_transactions_fact'[Invoice]),
			        'retail_transactions_fact'[Quantity] > 0,
			        'retail_transactions_fact'[Price] > 0
			    )
			)
		lineageTag: 24dc3233-5482-4c83-b25c-99894eb6f6b0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Order Value' =
			
			DIVIDE(
			    CALCULATE(
			        SUM('retail_transactions_fact'[LineValue]),
			        'retail_transactions_fact'[Customer ID] <> BLANK()
			    ),
			    CALCULATE(
			        DISTINCTCOUNT('retail_transactions_fact'[Invoice]),
			        'retail_transactions_fact'[Customer ID] <> BLANK(),
			        'retail_transactions_fact'[Quantity] > 0,
			        'retail_transactions_fact'[Price] > 0
			    )
			)
		lineageTag: ee85482a-7e84-4831-91f7-81860df8dd51

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Historical Monetary by Segment' =
			
			CALCULATE(
			    SUM('retail_transactions_fact'[LineValue]),
			    'retail_transactions_fact'[Customer ID] <> BLANK()
			)
		lineageTag: 9ded179b-5495-464c-9fc6-406fb23b8e96

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top 3 & Others Monetary' =
			
			VAR TopSegments =
			    TOPN(
			        3,
			        ADDCOLUMNS(
			            ALL('retail customer_master'[segment]),
			            "@Monetary",
			            CALCULATE([Historical Monetary by Segment])
			        ),
			        [@Monetary], DESC,
			        'retail customer_master'[segment], ASC
			    )
			
			VAR CurrentCategory =
			    SELECTEDVALUE('Legend Categories'[Category])
			
			VAR OtherSegments =
			    EXCEPT(
			        ALL('retail customer_master'[segment]),
			        SELECTCOLUMNS(
			            TopSegments,
			            "segment", 'retail customer_master'[segment]
			        )
			    )
			
			RETURN
			    SWITCH(
			        TRUE(),
			        CurrentCategory = "Others",
			            CALCULATE(
			                [Historical Monetary by Segment],
			                OtherSegments
			            ),
			
			        CONTAINS(
			            TopSegments,
			            'retail customer_master'[segment],
			            CurrentCategory
			        ),
			            CALCULATE(
			                [Historical Monetary by Segment],
			                TREATAS(
			                    {CurrentCategory},
			                    'retail customer_master'[segment]
			                )
			            ),
			
			        BLANK()
			    )
		lineageTag: 0a68973f-e5ab-46d8-bf85-4fb0f8df158a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'RFM Customers' =
			
			DISTINCTCOUNT('retail customer_master'[customer_id])
		formatString: 0
		lineageTag: e1f1dbee-c45b-4fab-bc4c-27f4db78f976

	measure 'Customer % of Total' =
			
			DIVIDE(
			    DISTINCTCOUNT('retail customer_master'[customer_id]),
			    CALCULATE(
			        DISTINCTCOUNT('retail customer_master'[customer_id]),
			        REMOVEFILTERS('retail customer_master'[segment])
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 86a9f5f3-d06c-4e51-8668-1fb636b93511

	measure 'Avg R' =
			
			AVERAGE('retail customer_master'[recency])
		lineageTag: e25522d3-d20f-4585-b056-6cd443159a21

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg F' =
			
			AVERAGE('retail customer_master'[frequency])
		lineageTag: bc7a94e8-ba86-4430-87f0-7327a4aecedd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg M' =
			
			AVERAGE('retail customer_master'[monetary])
		lineageTag: 575af4ed-6227-418f-b619-caa62301ae21

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Purchase Behavior Business Insight' =
			
			VAR TotalCustomers =
			    DISTINCTCOUNT('retail customer_master'[customer_id])
			
			VAR SelectedSegment =
			    SWITCH(
			        TRUE(),
			        NOT ISFILTERED('retail customer_master'[segment]),
			            "All RFM Segments",
			        HASONEVALUE('retail customer_master'[segment]),
			            SELECTEDVALUE('retail customer_master'[segment]),
			        "Selected RFM Segments"
			    )
			
			VAR BehaviorSummary =
			    ADDCOLUMNS(
			        VALUES('retail customer_master'[Purchase Behavior Category]),
			        "@Customers",
			        CALCULATE(
			            DISTINCTCOUNT('retail customer_master'[customer_id])
			        )
			    )
			
			VAR TopBehavior =
			    TOPN(
			        1,
			        BehaviorSummary,
			        [@Customers], DESC
			    )
			
			VAR DominantBehavior =
			    MAXX(
			        TopBehavior,
			        'retail customer_master'[Purchase Behavior Category]
			    )
			
			VAR DominantCount =
			    MAXX(TopBehavior, [@Customers])
			
			VAR DominantShare =
			    DIVIDE(DominantCount, TotalCustomers)
			
			VAR SegmentSummary =
			    ADDCOLUMNS(
			        VALUES('retail customer_master'[segment]),
			        "@AvgMonetary",
			        CALCULATE([Avg Monetary])
			    )
			
			VAR TopMonetarySegment =
			    TOPN(
			        1,
			        FILTER(
			            SegmentSummary,
			            NOT ISBLANK([@AvgMonetary])
			        ),
			        [@AvgMonetary], DESC
			    )
			
			VAR BestSegment =
			    MAXX(
			        TopMonetarySegment,
			        'retail customer_master'[segment]
			    )
			
			VAR BestMonetary =
			    MAXX(
			        TopMonetarySegment,
			        [@AvgMonetary]
			    )
			
			RETURN
			    IF(
			        TotalCustomers = 0,
			        "No customer data available.",
			        "Within " & SelectedSegment
			        & ", " & DominantBehavior
			        & " represents "
			        & FORMAT(DominantShare, "0.0%")
			        & " of customers ("
			        & FORMAT(DominantCount, "#,##0")
			        & " customers). "
			        & BestSegment
			        & " has the highest average monetary value ("
			        & FORMAT(BestMonetary, "#,##0.00")
			        & ") among the selected segments."
			    )
		lineageTag: 5da56287-ba9d-4b6b-a856-00b017094f3e

	measure 'RFM Key Takeaway' =
			
			VAR SelectedSegment =
			    SELECTEDVALUE(
			        'retail customer_master'[segment]
			    )
			RETURN
			    SWITCH(
			        SelectedSegment,
			
			        "Champions",
			        "High-value customers with strong loyalty. Focus on retention and exclusive rewards.",
			
			        "Loyal Customers",
			        "Consistent buyers with strong engagement. Encourage repeat purchases and upselling.",
			
			        "Potential Loyalists",
			        "Customers showing promising engagement. Nurture them toward long-term loyalty.",
			
			        "At Risk",
			        "Previously valuable customers with declining activity. Prioritize re-engagement campaigns.",
			
			        "Select an RFM segment to explore its key takeaway."
			    )
		lineageTag: 12a031ed-d4dc-41fc-9826-1b858809a104

